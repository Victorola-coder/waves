// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// Enums
enum ParticipantRole {
  HOST
  GUEST
}

enum MessageType {
  SYSTEM
  USER
}

enum MusicPlatform {
  SPOTIFY
  YOUTUBE
  OTHER
}

// Core models
model User {
  id          String            @id @default(uuid()) @db.Uuid
  email       String            @unique
  username    String?           @unique
  avatarUrl   String?           @map("avatar_url")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  roomsHosted ListeningRoom[]   @relation("RoomHost")
  participants RoomParticipant[]
  messages    Message[]
  spotify     SpotifyToken?
  tracksAdded Track[]        @relation("Track_addedBy")
  queueItems  RoomQueue[]    @relation("Queue_addedBy")

  @@map("users")
}

model ListeningRoom {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  hostId         String            @db.Uuid @map("host_id")
  isPrivate      Boolean           @default(false) @map("is_private")
  capacity       Int               @default(50)
  currentTrackId String?           @db.Uuid @map("current_track_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  host           User              @relation("RoomHost", fields: [hostId], references: [id])
  participants   RoomParticipant[]
  messages       Message[]
  queue          RoomQueue[]
  currentTrack   Track?            @relation("CurrentTrack", fields: [currentTrackId], references: [id])

  @@index([hostId])
  @@map("listening_rooms")
}

model RoomParticipant {
  id        String           @id @default(uuid()) @db.Uuid
  roomId    String           @db.Uuid @map("room_id")
  userId    String           @db.Uuid @map("user_id")
  role      ParticipantRole  @default(GUEST)
  isActive  Boolean          @default(true) @map("is_active")
  joinedAt  DateTime         @default(now()) @map("joined_at")
  leftAt    DateTime?        @map("left_at")

  room      ListeningRoom    @relation(fields: [roomId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([userId])
  @@map("room_participants")
}

model Track {
  id           String         @id @default(uuid()) @db.Uuid
  platform     MusicPlatform
  platformId   String         @map("platform_id")
  title        String
  artist       String
  durationMs   Int            @map("duration_ms")
  thumbnailUrl String?        @map("thumbnail_url")
  addedById    String?        @db.Uuid @map("added_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")

  addedBy      User?          @relation("Track_addedBy", fields: [addedById], references: [id])
  queueItems   RoomQueue[]
  currentForRooms ListeningRoom[] @relation("CurrentTrack")

  @@index([platform, platformId])
  @@map("tracks")
}

model RoomQueue {
  id         String         @id @default(uuid()) @db.Uuid
  roomId     String         @db.Uuid @map("room_id")
  trackId    String         @db.Uuid @map("track_id")
  addedById  String         @db.Uuid @map("added_by_id")
  position   Int
  createdAt  DateTime       @default(now()) @map("created_at")

  room       ListeningRoom  @relation(fields: [roomId], references: [id])
  track      Track          @relation(fields: [trackId], references: [id])
  addedBy    User           @relation("Queue_addedBy", fields: [addedById], references: [id])

  @@unique([roomId, position])
  @@index([roomId])
  @@index([trackId])
  @@map("room_queue")
}

model Message {
  id        String       @id @default(uuid()) @db.Uuid
  roomId    String       @db.Uuid @map("room_id")
  userId    String?      @db.Uuid @map("user_id")
  type      MessageType  @default(USER)
  content   String
  createdAt DateTime     @default(now()) @map("created_at")

  room      ListeningRoom @relation(fields: [roomId], references: [id])
  user      User?         @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
  @@map("messages")
}

model SpotifyToken {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid @map("user_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  scope        String?
  tokenType    String?  @map("token_type")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id])

  @@map("spotify_tokens")
}
