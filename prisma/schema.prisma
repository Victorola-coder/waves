// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Provider {
  spotify
  lastfm
}

enum RoomStatus {
  idle
  active
  ended
}

enum RoomRole {
  host
  mod
  listener
}

// Core models (MVP)
model User {
  id          String    @id @db.Uuid
  email       String    @unique
  passwordHash String
  displayName String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())

  // Relations
  connections Connection[]
  rooms       Room[]        @relation("UserRoomsHosted")
  memberships RoomMember[]
  queueItems  QueueItem[]   @relation("UserQueueItems")
}

model Connection {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  provider     Provider
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scopes       String[]
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model Room {
  id                 String      @id @db.Uuid
  hostId             String      @db.Uuid
  name               String
  isPrivate          Boolean     @default(false)
  status             RoomStatus  @default(idle)
  nowPlayingTrackId  String?
  startedAt          DateTime?
  createdAt          DateTime    @default(now())

  host       User        @relation("UserRoomsHosted", fields: [hostId], references: [id], onDelete: Cascade)
  members    RoomMember[]
  queue      QueueItem[]

  @@index([hostId])
}

model RoomMember {
  id        String   @id @db.Uuid
  roomId    String   @db.Uuid
  userId    String   @db.Uuid
  role      RoomRole @default(listener)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Track {
  id               String    @id @db.Uuid
  provider         Provider
  providerTrackId  String
  title            String
  artist           String
  album            String?
  durationMs       Int
  artworkUrl       String?
  createdAt        DateTime  @default(now())

  queueItems       QueueItem[]

  @@unique([provider, providerTrackId])
}

model QueueItem {
  id            String   @id @db.Uuid
  roomId        String   @db.Uuid
  trackId       String   @db.Uuid
  addedByUserId String   @db.Uuid
  position      Int
  playedAt      DateTime?
  createdAt     DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  track  Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedBy User  @relation("UserQueueItems", fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@index([roomId, position])
}
